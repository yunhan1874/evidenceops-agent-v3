APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
FRONTEND_PORT=3000
API_PORT=8000

DATABASE_URL=postgresql+asyncpg://agent:change-me@postgres:5432/agent
CHECKPOINT_DATABASE_URL=postgresql://agent:change-me@postgres:5432/agent?sslmode=disable

FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_ACCESS_TOKEN_URL=https://open.feishu.cn/open-apis/authen/v1/access_token
FEISHU_USERINFO_URL=https://open.feishu.cn/open-apis/authen/v1/user_info
EXCEL_WHITELIST_PATH=/app/data/whitelist.xlsx

# Local only. Production must be false.
DEV_AUTH_ENABLED=true
DEV_ADMIN_USERS=admin

RAG_BASE_URL=http://ragflow:9380
RAG_API_KEY=
RAG_CHAT_ID=
RAG_REQUEST_TIMEOUT_SECONDS=90
RAG_MOCK_MODE=true

# Optional OpenAI-compatible endpoint. Empty means deterministic fallback routing.
# Qwen OpenAI-compatible example. Keep the key only in a local secret/environment.
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=
LLM_MODEL=qwen3.8-max
LLM_ROUTER_MODEL=qwen3.8-max
LLM_PRIMARY_MODEL=qwen3.8-max
LLM_HIGH_RISK_MODEL=qwen3.8-max
LLM_SHADOW_MODEL=
LLM_TIMEOUT_SECONDS=45
LLM_MAX_ATTEMPTS=2
LLM_RETRY_BACKOFF_SECONDS=0.5
LLM_CIRCUIT_FAILURE_THRESHOLD=3
LLM_CIRCUIT_COOLDOWN_SECONDS=60

# Execution Harness budgets and context/tool boundaries.
MAX_AGENT_STEPS=8
MAX_TOOL_CALLS=6
MAX_RUN_SECONDS=120
MAX_LLM_ESTIMATED_TOKENS=8000
CONTEXT_MAX_CHARS=3000
CONTEXT_MAX_TURNS=4
TOOL_MAX_OUTPUT_CHARS=12000
TOOL_EGRESS_ALLOWLIST=ragflow,localhost,127.0.0.1,dashscope.aliyuncs.com

# Evidence Passport policy. High-risk questions use the stricter threshold.
EVIDENCE_MIN_AVERAGE_SCORE=0.55
EVIDENCE_HIGH_RISK_MIN_SCORE=0.75
EVIDENCE_COMPARE_MIN_SOURCES=2
EVIDENCE_MAX_CITATIONS=10
